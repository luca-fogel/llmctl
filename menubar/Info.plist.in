<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>               <string>LLM Memory</string>
	<key>CFBundleDisplayName</key>        <string>LLM Memory</string>
	<key>CFBundleIdentifier</key>         <string>com.foggylulu.llmmenu</string>
	<key>CFBundleExecutable</key>         <string>LLMMenu</string>
	<key>CFBundlePackageType</key>        <string>APPL</string>
	<key>CFBundleShortVersionString</key> <string>@VERSION@</string>
	<key>CFBundleVersion</key>            <string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>     <string>13.0</string>
	<key>LSApplicationCategoryType</key>  <string>public.app-category.developer-tools</string>
	<!-- REQUIRED for a bundle built straight from swiftc: without it AppKit
	     never finishes launching. -->
	<key>NSPrincipalClass</key>           <string>NSApplication</string>
	<key>NSHighResolutionCapable</key>    <true/>
	<!-- Menu bar only: no Dock icon, no window on launch. The panel is still
	     Spotlight-launchable by the bundle name. -->
	<key>LSUIElement</key>                <true/>
	<!-- llmctl talks plain HTTP to loopback (LM Studio :1234, LocalAI :8080).
	     Without this the app's own URL loads would be refused. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
</dict>
</plist>
